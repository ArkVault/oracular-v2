# Public browser configuration. VITE_ values are bundled into the client and
# must never contain secrets. The app has demo defaults when these are omitted.
VITE_COPERNICUS_WMS_URL=https://sh.dataspace.copernicus.eu/ogc/wms/your-public-instance-id
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
VITE_BASEMAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Legacy Task Master tooling (not used by the browser app)
ANTHROPIC_API_KEY=your_anthropic_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key

# Optional - defaults shown
MODEL=claude-3-7-sonnet-20250219
PERPLEXITY_MODEL=sonar-medium-online
MAX_TOKENS=4000
TEMPERATURE=0.7
DEBUG=false
LOG_LEVEL=info
DEFAULT_SUBTASKS=3
DEFAULT_PRIORITY=medium
PROJECT_NAME=Oracular V2
